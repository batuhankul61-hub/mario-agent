# Copy this file to backend/.env and fill in the key. backend/.env is git-ignored.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required to use Mario from the phone (or anything not on this PC).
# Pick a long random code; the phone asks for it once.
ACCESS_CODE=

# Optional: how Mario addresses you
# USER_NAME=Ada

# Optional overrides
# LIVE_MODEL=gemini-3.8-live
# VOICE=Puck
# PROGRAMS_DIR=C:\Users\<you>\Desktop\Kisayollar
# CLAUDE_WORKDIR=C:\path\to\Mario_Agent\claude-workspace

# Memory / RAG (see README, "Hafıza")
# MEMORY_DOCS_DIR=C:\path\to\Mario_Agent\notes
# EMBEDDING_MODEL=gemini-embedding-001
# AGENT_MODEL=gemini-3.5-flash-lite
# JUDGE_MODEL=gemini-3.1-flash-lite
# CHUNK_SIZE=400
# CHUNK_OVERLAP=80

# Things Mario says first (README, "Kendiliğinden haber verir")
# NOTIFY_MAIL=true
# NOTIFY_CALENDAR=true
# NOTIFY_BATTERY_PERCENT=20
# TOAST_NOTIFICATIONS=true

# Wake-on-LAN (wake_device): name -> MAC as JSON. Add @broadcast for another subnet.
# WOL_DEVICES={"masaüstü": "AA:BB:CC:DD:EE:FF", "sunucu": "11:22:33:44:55:66@192.168.1.255"}
# WOL_BROADCAST=255.255.255.255

# true = destructive tools only say what they would do (demos, tests)
DRY_RUN=false
