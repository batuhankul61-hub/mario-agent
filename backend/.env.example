# Copy this file to backend/.env and fill in the key. backend/.env is git-ignored.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required to use Mario from the phone (or anything not on this PC).
# Pick a long random code; the phone asks for it once.
ACCESS_CODE=

# Optional overrides
# LIVE_MODEL=gemini-3.8-live
# VOICE=Puck
# PROGRAMS_DIR=D:\Users\Batu\AppData\Local\Programs\JARVIS-ekler\Programlar
# CLAUDE_WORKDIR=F:\Projeler\Mario_Agent\claude-workspace

# Memory / RAG (see README, "Hafıza")
# MEMORY_DOCS_DIR=F:\Projeler\Mario_Agent\notes
otes
# EMBEDDING_MODEL=gemini-embedding-001
# AGENT_MODEL=gemini-3.5-flash-lite
# JUDGE_MODEL=gemini-3.1-flash-lite
# CHUNK_SIZE=400
# CHUNK_OVERLAP=80

# true = destructive tools only say what they would do (demos, tests)
DRY_RUN=false
